# Copy to .env (never commit .env).

# FRED: free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Without it the engine still works using FRED's public CSV export, but without
# revision history (publication dates of old data are estimated).
FRED_API_KEY=

# Phase 4
ANTHROPIC_API_KEY=
# Jarvis's brain: auto (Claude if the key is set) | demo
# BRAIN=auto
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=medium
ELEVENLABS_API_KEY=
# Jarvis's voice: auto (ElevenLabs if the key is set) | elevenlabs | browser
# VOICE=auto
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9   (Daniel; list: GET /v1/voices)
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Real spot quotes (XAU/USD) for verifying predictions: free key at https://twelvedata.com
TWELVEDATA_API_KEY=

# Optional
# DATABASE_URL=sqlite:///backend/data/royaumoney.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/royaumoney
# SCHEDULER_ENABLED=true
# SCHEDULER_TIMEZONE=Europe/Rome
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000
